# Copy to .env.local and fill in. Every variable is optional: without it the
# app still runs and logs the payload to the server console instead.

# MongoDB connection string (Atlas or local). The database name comes from the
# path; collections and indexes are created by Mongoose on first use.
MONGODB_URI="mongodb+srv://user:password@cluster-example.mongodb.net/mdr?retryWrites=true&w=majority"

# Resend API key for pre-order confirmation emails.
RESEND_API_KEY=""
# Sender address on a domain verified in Resend. Defaults to onboarding@resend.dev.
RESEND_FROM="MDR <hello@your-domain.com>"

# Public address of the site, used for canonical, Open Graph, robots.txt and
# sitemap.xml URLs. On Vercel the production domain is picked up automatically;
# locally it falls back to http://localhost:3000.
SITE_URL="https://your-domain.com"
